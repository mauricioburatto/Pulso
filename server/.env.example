DATABASE_URL="postgresql://user:password@localhost:5432/pulso"
JWT_SECRET="troque-por-um-segredo-forte-de-verdade"
PORT=3000
CLIENT_ORIGIN="http://localhost:5173"

# Object storage (opcional) — sem essas variáveis, fotos vão pro disco
# local em server/uploads/ (só para desenvolvimento).
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_PUBLIC_URL_BASE=

# Envio de email (opcional) — sem essas variáveis, o código de
# recuperação de senha é apenas gravado em server/dev-emails/ (só para
# desenvolvimento), não enviado de verdade.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Pulso <no-reply@seudominio.com>"

# IA (opcional) — sem ANTHROPIC_API_KEY, as rotas /ai/* respondem 503.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
